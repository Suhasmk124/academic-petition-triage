# Values are intentionally blank in version control. See docs/hosted_agents.md.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# This is your confirmation of account status, not an automated billing check.
LLM_FREE_PLAN_CONFIRMED=false
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1800
LLM_REASONING_EFFORT=
LLM_FORCE_TOOL_START=false

# Service mode is independent of hosted CLI credentials; hosted is disabled here.
TRIAGE_MODE=stub
# Leave blank/unset for the project-local default; otherwise use the same path for API and worker.
# TRIAGE_DB_PATH=
TRIAGE_QUEUE_CAPACITY=100
TRIAGE_LEASE_SECONDS=120
TRIAGE_STUB_DELAY_SECONDS=0.15

# Operational deployment. Compose supplies internal service addresses and key files.
TRIAGE_ALLOW_HOSTED=false
TRIAGE_PROMPT_VARIANT=strict
TRIAGE_JOB_TIMEOUT=180
TRIAGE_CACHE_TTL=0
TRIAGE_RATE_LIMIT=0
TRIAGE_API_KEY=
TRIAGE_API_KEY_FILE=
STUB_SERVICE_URL=
REDIS_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=petition-triage
# Optional embedding/index overrides; blank keeps backward-compatible local defaults.
EMBEDDING_MODEL=
CHROMA_PATH=
CHROMA_COLLECTION=
