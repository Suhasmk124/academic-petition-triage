{
  "title": "Academic petition operations",
  "uid": "petition-triage",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(triage_http_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Queue depth",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "triage_jobs{status=\"QUEUED\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Active workers",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "triage_active_workers",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Agent calls",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "triage_agent_runs_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Agent time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "triage_agent_duration_seconds_sum",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Tool calls",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "triage_agent_tool_calls_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Model retries",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "triage_agent_retries_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "API uptime",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "triage_uptime_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Tokens (reported or estimated)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "triage_tokens_total",
          "refId": "A"
        }
      ]
    }
  ]
}