{
  "title": "Academic petition operations",
  "uid": "petition-triage",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Workflow p95 (seconds)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(triage_workflow_duration_seconds_bucket{status=\"SUCCEEDED\"}[1m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Workflows completed per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(triage_workflow_duration_seconds_count[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Queue depth",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "triage_jobs{status=\"QUEUED\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active workers",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "triage_active_workers",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Oldest queued petition (seconds)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "triage_oldest_queued_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Failed workflows in the last minute",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "increase(triage_workflow_duration_seconds_count{status=\"FAILED\"}[1m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Submission HTTP p95 (seconds)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(triage_http_duration_seconds_bucket{route=~\"/petitions(/private)?\"}[1m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "API errors per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(triage_http_requests_total{status=~\"[45]..\"}[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Agent calls",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "triage_agent_runs_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Agent time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "triage_agent_duration_seconds_sum",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Tool calls",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "triage_agent_tool_calls_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Model retries",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "triage_agent_retries_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "API uptime",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "triage_uptime_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "title": "Tokens (reported or estimated)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "triage_tokens_total",
          "refId": "A"
        }
      ]
    }
  ]
}